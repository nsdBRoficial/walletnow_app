{
  "name": "@walletnow/onboarding",
  "version": "0.1.1",
  "description": "WalletNow — Onboarding Domain (First-Class). The simplest way to put a user inside Stellar.",
  "keywords": [
    "stellar",
    "onboarding",
    "wallet",
    "infrastructure",
    "walletnow"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@walletnow/contracts": "*",
    "@stellar/stellar-sdk": "^12.0.0",
    "@walletnow/crypto": "*",
    "@walletnow/storage": "*",
    "@walletnow/identity": "*",
    "@walletnow/wallet": "*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
