{
  "name": "@walletnow/testing",
  "version": "0.1.1",
  "description": "WalletNow OS — Testing utilities: Fake engines, mock providers, builders and test helpers for isolated unit testing",
  "keywords": [
    "stellar",
    "testing",
    "mocks",
    "fakes",
    "vitest",
    "jest",
    "walletnow"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@walletnow/contracts": "*",
    "@walletnow/storage": "*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
