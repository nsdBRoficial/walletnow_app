{
  "name": "@walletnow/crypto",
  "version": "0.1.1",
  "description": "WalletNow OS — Cryptographic operations (key derivation, signing, encryption, hashing) for Stellar",
  "keywords": [
    "stellar",
    "crypto",
    "ed25519",
    "aes-gcm",
    "pbkdf2",
    "bip39",
    "web-crypto",
    "walletnow"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@walletnow/contracts": "*",
    "@stellar/stellar-sdk": "^12.1.0",
    "@scure/bip39": "^1.3.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
