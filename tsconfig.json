{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@walletnow/contracts": ["./packages/contracts/src/index.ts"],
      "@walletnow/crypto": ["./packages/crypto/src/index.ts"],
      "@walletnow/storage": ["./packages/storage/src/index.ts"],
      "@walletnow/identity": ["./packages/identity/src/index.ts"],
      "@walletnow/wallet": ["./packages/wallet/src/index.ts"],
      "@walletnow/onboarding": ["./packages/onboarding/src/index.ts"],
      "@walletnow/testing": ["./packages/testing/src/index.ts"],
      "@walletnow/domain": ["./packages/domain/src/index.ts"],
      "@walletnow/providers": ["./packages/providers/src/index.ts"],
      "@walletnow/nft": ["./packages/nft/src/index.ts"],
      "@walletnow/core": ["./packages/core/src/public/index.ts"],
      "@walletnow/sdk": ["./packages/sdk/src/index.ts"],
      "@walletnow/sdk/*": ["./packages/sdk/src/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "supabase/functions",
    "legacy"
  ]
}
